  "permissions": ["core:event:default", "allow-get-preferences", "allow-get-host-status", "allow-set-preferences", "allow-read-usage", "allow-ready", "allow-begin-drag", "allow-set-hit-regions", "allow-get-theme", "allow-read-source", "allow-cancel-source", "allow-get-queue", "allow-mark-showing", "allow-finish-message", "allow-open-settings"]
}
