{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Trusted bundled settings window; never shared with theme origins.",
  "windows": ["settings"],
  "permissions": ["core:event:default", "allow-get-preferences", "allow-set-preferences", "allow-get-theme", "allow-import-asset", "allow-import-theme", "allow-read-source", "allow-cancel-source", "allow-clear-queue", "allow-get-server-status", "allow-get-http-token", "allow-set-settings-activity"]
}
